# ===========================================
# AI Voice Intake - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files with real keys to git!

# -----------------
# LiveKit (Required)
# -----------------
# Get these from https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# For frontend (Next.js public variable)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# -----------------
# LLM Provider (Required - choose one)
# -----------------
# Option 1: OpenRouter (recommended - cheaper, supports multiple models)
# Get from https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Option 2: OpenAI Direct
# Get from https://platform.openai.com/
# OPENAI_API_KEY=sk-your_openai_key_here

# -----------------
# Speech Services (Auto-configured via LiveKit)
# -----------------
# Deepgram STT - Get from https://console.deepgram.com/
# (Optional - LiveKit handles this if you have credits)
# DEEPGRAM_API_KEY=your_deepgram_key_here

# ElevenLabs TTS - Get from https://elevenlabs.io/
# (Optional - falls back to OpenAI TTS if not set)
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
